{
  "name": "dsh-market",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A DSH plugin market that lives entirely in one Git repository: JSON index + plugin packages as subdirectories.",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build-index.mjs",
    "check": "node scripts/build-index.mjs --check",
    "serve": "node scripts/serve.mjs",
    "mirror": "./scripts/mirror.sh",
    "pack:hello": "pnpm --dir plugins/dsh-hello-world pack"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "0.2.2-rc.3"
  }
}
