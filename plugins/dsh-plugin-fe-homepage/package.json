{
  "name": "dsh-plugin-fe-homepage",
  "version": "0.1.4",
  "description": "前端主页：一个标签页里看全所有前端项目的开发/测试/预生产/生产地址、常用入口和小程序发版步骤。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "homepage",
    "frontend",
    "环境",
    "前端地址"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./assets/*": "./assets/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "assets",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "author": "iShawnWang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iShawnWang/dsh-market.git",
    "directory": "plugins/dsh-plugin-fe-homepage"
  },
  "homepage": "https://github.com/iShawnWang/dsh-market"
}
